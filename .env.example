# Облачный проект Supabase: Project Settings → API Keys.
# Нужны для сборки фронта (Vercel) и для `npm run seed -- --cloud`.
# `npm run dev` и тесты их не используют — берут локальный Supabase из `supabase status`.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Только для scripts/seed.ts --cloud. Обходит RLS: на фронт и в репозиторий не попадает
SUPABASE_SECRET_KEY=sb_secret_...

# Пароль демо-пользователей, которых создаёт scripts/seed.ts (не короче 8 символов)
DEMO_PASSWORD=
